# === Google Cloud / Gemini ===
# Option A: Gemini API (for local dev without GCP)
GOOGLE_API_KEY=your-gemini-api-key
# Option B: Vertex AI (for GCP deployment — uses default service account)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# === Dynatrace MCP (partner integration) ===
DT_ENVIRONMENT=https://your-environment.apps.dynatrace.com
DT_PLATFORM_TOKEN=your-dynatrace-platform-token
# === Dynatrace classic API token (problems.read + entities.read) ===
DT_CLASSIC_TOKEN=your-dynatrace-classic-token
# === Dynatrace OTel token (openTelemetryTrace.ingest scope) ===
DT_OTEL_TOKEN=your-dynatrace-otel-token

# === Firestore (health check history) ===
# Leave blank to disable persistence (local dev fallback)
FIRESTORE_DATABASE_ID=
FIRESTORE_COLLECTION=health-checks

# === Cloud Scheduler ===
SCHEDULED_CHECK_SECRET=your-secret-for-scheduled-checks

# === WordPress site to monitor ===
WP_SITE_URL=https://example.com
