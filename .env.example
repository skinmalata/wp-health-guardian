# Google Cloud / Gemini
GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_CLOUD_PROJECT=your-project-id

# Dynatrace (for MCP integration)
DT_ENVIRONMENT=https://your-environment.apps.dynatrace.com
DT_PLATFORM_TOKEN=your-dynatrace-platform-token

# WordPress site to monitor
WP_SITE_URL=https://example.com
WP_ADMIN_URL=https://example.com/wp-admin
